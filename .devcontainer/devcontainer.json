{
  // Open in GitHub Codespaces: the whole stack runs with the "sim" profile (no API key, no GPU).
  "name": "Virtual AI Factory (sim stack)",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/python:1": { "version": "3.12" },
    "ghcr.io/devcontainers/features/node:1": { "version": "24" }
  },
  "hostRequirements": { "cpus": 4, "memory": "16gb", "storage": "32gb" },
  "postCreateCommand": "bash .devcontainer/setup-env.sh",
  "postStartCommand": "docker compose --profile sim up -d --build",
  "forwardPorts": [80, 3001, 3002],
  "portsAttributes": {
    "80": { "label": "Dashboard + API", "onAutoForward": "openBrowser" },
    "3001": { "label": "Grafana" },
    "3002": { "label": "Langfuse" }
  },
  "customizations": {
    "codespaces": { "openFiles": ["README.md"] }
  }
}

<!-- ClickHouse tuning for a single small host (Langfuse traces only): smaller caches and
     no growing system log tables. Mounted in /etc/clickhouse-server/config.d/. -->
<clickhouse>
    <logger>
        <level>warning</level>
        <console>true</console>
    </logger>
    <mark_cache_size>268435456</mark_cache_size>
    <uncompressed_cache_size>134217728</uncompressed_cache_size>
    <max_server_memory_usage_to_ram_ratio>0.75</max_server_memory_usage_to_ram_ratio>
    <query_log remove="1"/>
    <query_thread_log remove="1"/>
    <query_views_log remove="1"/>
    <query_metric_log remove="1"/>
    <trace_log remove="1"/>
    <text_log remove="1"/>
    <metric_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <part_log remove="1"/>
    <processors_profile_log remove="1"/>
    <opentelemetry_span_log remove="1"/>
    <session_log remove="1"/>
    <latency_log remove="1"/>
    <error_log remove="1"/>
    <backup_log remove="1"/>
    <blob_storage_log remove="1"/>
</clickhouse>
